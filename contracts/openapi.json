  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PatchRepoRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "active",
                  "disabled"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "PatchRepoRequest"
      },
      "ProbeRequest": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "configured",
              "fixture"
            ],
            "title": "Source",
            "default": "fixture"
          },
          "case_id": {
            "type": "string",
            "enum": [
              "normal_pr",
              "risk_pr",
              "failed_ci"
            ],
            "title": "Case Id",
            "default": "normal_pr"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProbeRequest"
      },
      "RegisterRepoRequest": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 201,
            "minLength": 3,
            "title": "Full Name"
          },
          "credential_ref": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Credential Ref",
            "default": "github-default"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "RegisterRepoRequest"
      },
      "SyncRequest": {
        "properties": {
          "resources": {
            "items": {
              "$ref": "#/components/schemas/SyncResource"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Resources"
          },
          "mode": {
            "type": "string",
            "const": "incremental",
            "title": "Mode",
            "default": "incremental"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SyncRequest"
      },
      "SyncResource": {
        "type": "string",
        "enum": [
          "issues",
          "pulls",
          "reviews",
          "ci",
          "events"
        ],
        "title": "SyncResource"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}