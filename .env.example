APP_ENV=local
APP_ORIGIN=http://localhost:3100
API_PORT=8100
WEB_PORT=3100
POSTGRES_PORT=55432
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+psycopg://devflow:replace-with-generated-secret@localhost:55432/devflow
STORAGE_ROOT=var
COOKIE_SECURE=false
SESSION_HOURS=12
LLM_PROVIDER=openai_compatible
# An API root including /v1; the adapter appends /chat/completions.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TOKEN_PARAMETER=max_completion_tokens
# json_schema (default, OpenAI-style strict) or json_object for providers like DeepSeek
# that reject response_format json_schema; the schema is then carried in the prompt and
# server-side validation stays the same.
LLM_STRUCTURED_OUTPUT=json_schema
MODEL_TIMEOUT_SECONDS=20
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TOTAL_TOKEN_BUDGET=30000
MODEL_OUTPUT_TOKEN_LIMIT=3000
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=2
WORKER_RECOVERY_SECONDS=60
# GitHub read credentials: leave empty for public repositories (anonymous access).
# GITHUB_WRITE_TOKEN is never used until draft execution exists (M6).
GITHUB_READ_TOKEN=
GITHUB_WRITE_TOKEN=
GITHUB_API_BASE=https://api.github.com
# true = honor system proxy/CA settings (Windows registry + env vars) for GitHub
# requests. Default false: direct egress. Shared proxy exit IPs usually have an
# exhausted anonymous GitHub quota, so only enable when the network requires it.
GITHUB_TRUST_ENV=false
# Optional HTTP(S) proxy used only for git fetch/clone of GitHub repositories
# (API requests follow GITHUB_TRUST_ENV). Example: http://127.0.0.1:7897
GITHUB_GIT_PROXY=
# Sync bounds per run (README 8.2): page cap per resource, lookback windows.
SYNC_MAX_PAGES=4
SYNC_ISSUE_WINDOW_DAYS=90
SYNC_CI_WINDOW_DAYS=30
SYNC_OVERLAP_MINUTES=5
SYNC_REVIEW_MAX_PRS=10
SYNC_CI_JOB_MAX_RUNS=5
# Job queue (README 17): lease, retries, backoff.
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=30
JOB_RETRY_MAX_DELAY_SECONDS=900
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
# Code workspace bounds (README 9.2).
MAX_CODE_FILE_BYTES=1048576
MAX_READ_LINES=400
MAX_SEARCH_MATCHES=100
SEARCH_TIMEOUT_SECONDS=5
# Knowledge base (M3). BM25 works out of the box; the vector channel needs an
# OpenAI-compatible embeddings endpoint plus Milvus (compose profile "knowledge").
# With pymilvus missing or Milvus unreachable the base degrades to BM25-only and
# records the degraded flag - it never claims a complete RAG.
MAX_DOCUMENT_BYTES=5242880
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
MILVUS_URI=
RERANK_MODEL=
RAG_CHUNK_TARGET_TOKENS=600
RAG_CHUNK_MAX_TOKENS=900
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_TOP_K_PER_CHANNEL=20
RAG_RERANK_K=20
RAG_FINAL_K=6
BM25_MAX_CHUNKS_PER_REPO=50000
